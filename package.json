{
  "name": "valuasi-ekosistem-portal",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Portal identifikasi ekosistem dan valuasi ekonomi jasa ekosistem pada kawasan lindung dan berfungsi lindung",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "data:extract": "node tools/extract-workbook.mjs",
    "lint": "tsc -b --noEmit"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "recharts": "^3.1.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
